# Copy to .env at the repository root: `cp .env.example .env`
# Values below match docker-compose.yml, so local development works out of the box.

# --- Database -------------------------------------------------------------------
# Owner connection. Used ONLY for migrations and test setup; it bypasses RLS.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/closer
# Runtime connection used by the API, as the non-bypass role `closer_app`.
# RLS policies apply to every query made through it.
DATABASE_APP_URL=postgres://closer_app:closer_app@localhost:5433/closer

# Job queues (BullMQ). Matches the redis service in docker-compose.yml.
REDIS_URL=redis://localhost:6380

# --- Auth (Better Auth) ---------------------------------------------------------
# At least 32 random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin that serves /api/auth. The web app proxies /api/* to the API,
# so this is the web origin, not the API's.
BETTER_AUTH_URL=http://localhost:3000
# Browser origin allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:3000

# --- API ------------------------------------------------------------------------
API_PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Embeddings (Voyage AI) ---------------------------------------------------
# Get a key at https://www.voyageai.com. Without it, local ingestion falls back to an
# offline fake embedder (search works but results are not semantic). Required in production.
VOYAGE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=voyage-4

# --- File storage --------------------------------------------------------------
# local: files under LOCAL_STORAGE_DIR (development). supabase: private bucket (production).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
# Required when STORAGE_DRIVER=supabase. The service_role key is a secret: server only.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=documents

# --- Web ------------------------------------------------------------------------
# Where the Next.js server reaches the API (server-side fetches and the /api rewrite).
# Next.js reads env from apps/web; set it in apps/web/.env.local only if it differs.
# API_INTERNAL_URL=http://localhost:4000
