{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DATABASE_APP_URL", "REDIS_URL"]
    },
    "dev:worker": {
      "cache": false,
      "persistent": true
    }
  }
}
