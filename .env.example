# Copy to .env at the repository root: `cp .env.example .env`
# Values below match docker-compose.yml, so local development works out of the box.

# --- Database -------------------------------------------------------------------
# Owner connection. Used ONLY for migrations and test setup; it bypasses RLS.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/closer
# Runtime connection used by the API, as the non-bypass role `closer_app`.
# RLS policies apply to every query made through it.
DATABASE_APP_URL=postgres://closer_app:closer_app@localhost:5433/closer

# --- Auth (Better Auth) ---------------------------------------------------------
# At least 32 random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin that serves /api/auth. The web app proxies /api/* to the API,
# so this is the web origin, not the API's.
BETTER_AUTH_URL=http://localhost:3000
# Browser origin allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:3000

# --- API ------------------------------------------------------------------------
API_PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Web ------------------------------------------------------------------------
# Where the Next.js server reaches the API (server-side fetches and the /api rewrite).
# Next.js reads env from apps/web; set it in apps/web/.env.local only if it differs.
# API_INTERNAL_URL=http://localhost:4000
