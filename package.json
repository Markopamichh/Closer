{
  "name": "closer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @closer/db db:generate",
    "db:migrate": "pnpm --filter @closer/db db:migrate"
  },
  "devDependencies": {
    "@closer/config": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
