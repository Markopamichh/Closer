{
  "name": "@closer/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@closer/ai": "workspace:*",
    "@closer/db": "workspace:*",
    "@closer/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.6",
    "bullmq": "^6.3.10",
    "csv-parse": "^7.0.3",
    "hono": "^4.13.10",
    "ioredis": "^6.0.0",
    "mammoth": "^1.13.0",
    "pino": "^10.3.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
